{
  "rewrites": [
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|webmanifest|map))",
      "destination": "/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!assets|icon-|manifest\\.json|sw\\.js|logo\\.svg|apple-touch-icon|assetlinks\\.json|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}